          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %@ y pregunta. Neko escucha mientras hablas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %@ et parlez. Neko écoute jusqu’à ce que vous vous taisiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi %@ e chiedi. Neko ascolta finché parli."
          }
        }
      }
    },
    "Press %@ and ask. Neko listens until you stop talking. Hold the same keys instead and a line to type in opens beside it." : {
      "comment" : "Press %@ and ask. Neko listens until you stop talking. Hold the same keys instead and a line to type in opens beside it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press %@ and ask. Neko listens until you stop talking. Hold the same keys instead and a line to type in opens beside it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %@ y pregunta. Neko escucha hasta que dejas de hablar. Mantén pulsadas las mismas teclas y se abre al lado una línea para escribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %@ et demandez. Neko écoute jusqu’à ce que vous vous taisiez. Maintenez les mêmes touches et une ligne à écrire s’ouvre à côté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi %@ e chiedi. Neko ascolta finché smetti di parlare. Tieni premuti gli stessi tasti e accanto si apre una riga da scrivere."
          }
        }
      }
    },
