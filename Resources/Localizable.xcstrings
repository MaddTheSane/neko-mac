      }
    },
    "It adds routes without asking for the network, so nothing could be fetched." : {
      "comment" : "It adds routes without asking for the network, so nothing could be fetched.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It adds routes without asking for the network, so nothing could be fetched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade rutas sin pedir la red, así que no se podría descargar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ajoute des routes sans demander le réseau, donc rien ne pourrait être chargé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge rotte senza chiedere la rete, quindi non si potrebbe scaricare niente."
