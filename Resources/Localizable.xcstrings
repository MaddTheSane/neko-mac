    "macOS applies a change to screen recording only after Neko is restarted. And because this build is signed ad hoc, every rebuild of the app is a different app as far as the system is concerned: permissions granted to the previous one have to be granted again." : {
      "comment" : "macOS applies a change to screen recording only after Neko is restarted. And because this build is signed ad hoc, every rebuild of the app is a different app as far as the system is concerned: permissions granted to the previous one have to be granted again.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS applies a change to screen recording only after Neko is restarted. And because this build is signed ad hoc, every rebuild of the app is a different app as far as the system is concerned: permissions granted to the previous one have to be granted again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS aplica un cambio en la grabación de pantalla solo tras reiniciar Neko. Y como esta versión está firmada ad hoc, cada recompilación es otra app para el sistema: los permisos dados a la anterior hay que darlos de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’applique un changement d’enregistrement de l’écran qu’après un redémarrage de Neko. Et comme cette version est signée ad hoc, chaque recompilation est une autre app pour le système : les autorisations données à la précédente doivent être redonnées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS applica un cambio alla registrazione schermo solo dopo il riavvio di Neko. E siccome questa build è firmata ad hoc, ogni ricompilazione è per il sistema un'altra app: i permessi dati alla precedente vanno ridati."
          }
        }
      }
    },
    "macOS did not hand your %@ folder over: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS did not hand your %@ folder over: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no me entregó tu carpeta %@: %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne m’a pas remis votre dossier %@ : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non mi ha consegnato la cartella %@: %@"
          }
        }
      }
    },
    "macOS will not let me control %@ until you allow it in Privacy & Security, under Automation." : {
      "comment" : "macOS will not let me control %@ until you allow it in Privacy & Security, under Automation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS will not let me control %@ until you allow it in Privacy & Security, under Automation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no me deja controlar %@ hasta que lo permitas en Privacidad y seguridad, en Automatización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne me laisse pas commander %@ tant que vous ne l’autorisez pas dans Confidentialité et sécurité, sous Automatisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non mi lascia controllare %@ finché non lo permetti in Privacy e sicurezza, sotto Automazione."
          }
        }
