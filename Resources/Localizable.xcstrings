    "It has been shown no folders, so it cannot touch a file yet. Handing one over is a panel you fill in yourself; nothing else can grant it." : {
      "comment" : "It has been shown no folders, so it cannot touch a file yet. Handing one over is a panel you fill in yourself; nothing else can grant it.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It has been shown no folders, so it cannot touch a file yet. Handing one over is a panel you fill in yourself; nothing else can grant it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se le ha enseñado ninguna carpeta, así que no puede tocar ningún archivo. Entregarle una es un panel que rellenas tú; nada más lo concede."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun dossier ne lui a été montré, il ne peut donc toucher aucun fichier. En confier un passe par un panneau que vous remplissez vous-même ; rien d’autre ne l’accorde."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non gli è stata mostrata nessuna cartella, quindi non può toccare nessun file. Consegnargliene una è un pannello che compili tu; nient'altro può concederlo."
          }
        }
      }
    },
