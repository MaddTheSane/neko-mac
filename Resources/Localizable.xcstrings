  "strings" : {
    " — needed for what is switched on" : {
      "comment" : " - needed for what is switched on",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — needed for what is switched on"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — hace falta para lo que tienes encendido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — nécessaire pour ce qui est activé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — serve per quello che hai acceso"
          }
        }
      }
    },
    " After it speaks it keeps listening for a few seconds — the bubble says so while it does, and talking over it stops it mid-sentence." : {
      "comment" : " After it speaks it keeps listening for a few seconds — the bubble says so while it does, and talking over it stops it mid-sentence.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " After it speaks it keeps listening for a few seconds — the bubble says so while it does, and talking over it stops it mid-sentence."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Después de hablar sigue escuchando unos segundos —el globo lo dice mientras lo hace— y si le hablas encima se corta a mitad de frase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Après avoir parlé, il écoute encore quelques secondes — la bulle le dit pendant ce temps, et lui parler dessus l’arrête en pleine phrase."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Dopo che ha parlato resta in ascolto per qualche secondo — il fumetto lo dice mentre lo fa, e se gli parli sopra si interrompe a metà frase."
          }
        }
      }
    },
    " It is aiming at about %ld a day and will not speak more often than every %ld minutes." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " It is aiming at about %ld a day and will not speak more often than every %ld minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Apunta a unos %ld al día y no hablará más de una vez cada %ld minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Il vise environ %ld par jour et ne parlera pas plus d’une fois toutes les %ld minutes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " Punta a circa %ld al giorno e non parlerà più spesso di una volta ogni %ld minuti."
          }
        }
      }
    },
