    "Handed over one folder at a time, in a panel, so the cat can copy or move a file. Nothing is read until you do." : {
      "comment" : "Handed over one folder at a time, in a panel, so the cat can copy or move a file. Nothing is read until you do.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handed over one folder at a time, in a panel, so the cat can copy or move a file. Nothing is read until you do."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se entregan una carpeta cada vez, en un panel, para que el gato pueda copiar o mover un archivo. Hasta que lo hagas, no lee nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confiés un dossier à la fois, dans un panneau, pour que le chat puisse copier ou déplacer un fichier. Tant que vous ne le faites pas, rien n’est lu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si consegnano una cartella alla volta, da un pannello, così il gatto può copiare o spostare un file. Finché non lo fai, non legge niente."
          }
        }
      }
    },
