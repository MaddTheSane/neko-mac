    "Neko is not signed, so it never installs anything itself: it tells you, downloads the disk image if you say so, and you drag it across." : {
      "comment" : "Neko is not signed, so it never installs anything itself: it tells you, downloads the disk image if you say so, and you drag it across.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neko is not signed, so it never installs anything itself: it tells you, downloads the disk image if you say so, and you drag it across."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neko no está firmado, así que nunca instala nada por sí mismo: te lo dice, descarga la imagen de disco si se lo permites, y arrastrarla lo haces tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neko n’est pas signé, donc il n’installe jamais rien lui-même : il te le dit, télécharge l’image disque si tu le veux, et c’est toi qui la fais glisser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neko non è firmato, quindi non installa mai niente da sé: te lo dice, scarica l’immagine disco se glielo permetti, e il trascinamento lo fai tu."
          }
        }
      }
    },
